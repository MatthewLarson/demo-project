},"size":{"width":1.2,"height":0.35},"rotationY":252,"fontSize":0.3},"group":{"position":{"x":2.36971582,"y":1.846,"z":0.769967344},"rotationY":252}},{"seat":"brown","zones":[{"id":"seat-zone-brown-0","position":{"x":1.46456492,"y":1.846,"z":2.015800678},"size":{"x":1.328,"z":0.5},"rotationY":216,"type":"hand","primary":true,"hideFromOthers":true,"faceUpOnEnter":false,"cardOverlap":"left-over-right","newCardEnd":"right","sortMethods":[],"defaultSortMethodId":null}],"label":{"position":{"x":1.729068284,"y":1.846,"z":2.379858325},"size":{"width":1.2,"height":0.35},"rotationY":216,"fontSize":0.3},"group":{"position":{"x":1.46456492,"y":1.846,"z":2.015800678},"rotationY":216}}],"snapPoints":[],"scripts":[{"id":"script-0980be64-86e6-40cc-ba5b-d63e7260debd","name":"chess-turns.ts","language":"typescript","source":"// Chess turns: White moves first, and every finished move passes the turn.\n// Object script on the Chess Board. It watches pieces being put down and\n// keeps the seat-plate glow on whoever is to move.\n\nconst SIDES = [\"White\", \"Black\"] as const;\nlet seats: string[] = [];\nlet toMove = 0;\nlet moveNumber = 1;\n\nasync function setUp(): Promise<void> {\n  const zones = await world.getSeatZones();\n  for (const zone of zones) {\n    if (zone.seat !== null && seats.indexOf(zone.seat) === -1) {\n      seats.push(zone.seat);\n    }\n  }\n  seats = seats.slice(0, 2);\n  if (seats.length < 2) {\n    world.log(\"Chess needs two seats.\");\n    return;\n  }\n  world.setTurn(seats[toMove]);\n  ui.toast(\"White to move\", { tone: \"info\", icon: \"event_seat\" });\n}\n\nfunction isPiece(name: string | null | undefined): boolean {\n  return typeof name === \"string\" && /pawn|rook|knight|bishop|queen|king/i.test(name);\n}\n\nglobalEvents.onObjectDropped.add((entity, context) => {\n  if (context.actor === \"Script\" || seats.length < 2 || !isPiece(entity.name)) {\n    return;\n  }\n  world.log(`${moveNumber}. ${SIDES[toMove]} moved ${entity.name}`);\n  if (toMove === 1) {\n    moveNumber++;\n  }\n  toMove = 1 - toMove;\n  world.setTurn(seats[toMove]);\n  ui.toast(`${SIDES[toMove]} to move`, { tone: \"info\", icon: \"event_seat\" });\n});\n\nvoid setUp();\n","compiled":"\"use strict\";\n// Chess turns: White moves first, and every finished move passes the turn.\n// Object script on the Chess Board. It watches pieces being put down and\n// keeps the seat-plate glow on whoever is to move.\nconst SIDES = [\"White\", \"Black\"];\nlet seats = [];\nlet toMove = 0;\nlet moveNumber = 1;\nasync function setUp() {\n    const zones = await world.getSeatZones();\n    for (const zone of zones) {\n        if (zone.seat !== null && seats.indexOf(zone.seat) === -1) {\n            seats.push(zone.seat);\n        }\n    }\n    seats = seats.slice(0, 2);\n    if (seats.length < 2) {\n        world.log(\"Chess needs two seats.\");\n        return;\n    }\n    world.setTurn(seats[toMove]);\n    ui.toast(\"White to move\", { tone: \"info\", icon: \"event_seat\" });\n}\nfunction isPiece(name) {\n    return typeof name === \"string\" && /pawn|rook|knight|bishop|queen|king/i.test(name);\n}\nglobalEvents.onObjectDropped.add((entity, context) => {\n    if (context.actor === \"Script\" || seats.length < 2 || !isPiece(entity.name)) {\n        return;\n    }\n    world.log(`${moveNumber}. ${SIDES[toMove]} moved ${entity.name}`);\n    if (toMove === 1) {\n        moveNumber++;\n    }\n    toMove = 1 - toMove;\n    world.setTurn(seats[toMove]);\n    ui.toast(`${SIDES[toMove]} to move`, { tone: \"info\", icon: \"event_seat\" });\n});\nvoid setUp();\n","refKind":null,"variables":[],"updatedAt":"2026-10-19T20:27:39.351Z"}]}